# ==============================================================================
# BMC CivicConnect — Environment Configuration Template
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Client Application URL (For CORS Whitelist, comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yopnzzs.mongodb.net/bmc_civic_connect?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Vite Variables (For Client App)
VITE_API_URL=/api/v1
VITE_SOCKET_URL=https://your-backend.onrender.com
