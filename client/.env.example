# Client Frontend Environment Variables
# Leave empty or set to /api/v1 for relative reverse proxy / single-origin serving
VITE_API_URL=/api/v1
# For decoupled deployments (e.g. Vercel Frontend + Render Backend), set backend domain:
# VITE_API_URL=https://bmc-civicconnect-api.onrender.com/api/v1
# VITE_SOCKET_URL=https://bmc-civicconnect-api.onrender.com
